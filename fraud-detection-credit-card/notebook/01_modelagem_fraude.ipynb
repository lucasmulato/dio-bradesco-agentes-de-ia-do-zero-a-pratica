# Passo 1: Load
from src.data_loader import load_data
df = load_data()

# Passo 2: Preprocess
from src.preprocessing import preprocess
X_train, X_test, y_train, y_test = preprocess(df)

# Passo 3: Treinar 3 modelos
from src.models import get_models
models = get_models(y_train)
for name, model in models.items():
    model.fit(X_train, y_train)
    print(f"{name} treinado")

# Passo 4: Avaliar e ajustar limiar - Foco no Recall
from src.evaluate import evaluate, find_best_threshold
best_model = models['XGBoost'] # Geralmente o melhor
evaluate(best_model, X_test, y_test, threshold=0.5)

th, prec, rec = find_best_threshold(best_model, X_test, y_test)
print(f"Melhor limiar: {th:.3f} -> Precision {prec:.2f} Recall {rec:.2f}")
evaluate(best_model, X_test, y_test, threshold=th)

# Passo 5: SHAP
from src.explain import explain_model
explain_model(best_model, X_test)
